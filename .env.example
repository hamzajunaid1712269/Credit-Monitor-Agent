# Copy this file to .env and fill it in. Never commit .env.

# ---- Model: set ONE provider key and a matching MODEL ----
GOOGLE_API_KEY=your-gemini-key-from-aistudio.google.com
MODEL=google_genai:gemini-3.8-flash
# OPENAI_API_KEY=...        MODEL=openai:gpt-4.1-mini
# ANTHROPIC_API_KEY=...     MODEL=anthropic:claude-haiku-5-5
# GROQ_API_KEY=...          MODEL=groq:llama-3.3-70b-versatile

# SEC requires a real name and email in the User-Agent
SEC_USER_AGENT=Your Name your.email@example.com

# ---- Free-tier survival (defaults suit Gemini's free tier: ~20 requests/day) ----
# LLM_MIN_INTERVAL=12        # seconds between LLM calls
# LLM_MAX_CALLS_PER_RUN=18   # stop cleanly before the daily quota; resume next run
# LLM_MAX_RETRIES=4
# LLM_BACKOFF_BASE=15        # 15s, 30s, 60s, 120s
# LLM_MAX_WAIT=180           # provider asks to wait longer than this -> treat as daily quota

# ---- Agent ----
# MAX_TOOL_ROUNDS=3
# FILING_CHAR_BUDGET=14000
